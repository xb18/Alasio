{
  "useTabs": false,
  "singleQuote": false,
  "printWidth": 120,
  "plugins": ["prettier-plugin-svelte", "@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^@lucide/svelte/(.*)$",
    "^\\$(lib|src|app|private|routes|public)/(.*)$",
    "^[./]"
  ],
  "importOrderSortSpecifiers": true
}
